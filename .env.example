# Required for the basic workspace. Copy to .env.local and fill in your own values.
# Firebase console > Project settings > Your apps > Web app configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional server integrations are documented in docs/integrations.md.
# Never put service account JSON, OAuth secrets, or private API keys in NEXT_PUBLIC_ variables.
